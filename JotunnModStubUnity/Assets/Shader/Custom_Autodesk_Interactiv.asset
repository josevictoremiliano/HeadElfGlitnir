          vert( appdata_base v )\n{\n    v2f o;\n    UNITY_SETUP_INSTANCE_ID(v);\n   
          UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);\n    TRANSFER_SHADOW_CASTER_NORMALOFFSET(o)\n   
